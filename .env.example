# Скопируй в .env.local и заполни

# MongoDB: локально, через Docker или MongoDB Atlas
# Локально:  mongodb://127.0.0.1:27017/hozmag
# Atlas:     mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/hozmag
MONGODB_URI=mongodb://127.0.0.1:27017/hozmag

# Секрет для подписи сессий NextAuth.
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Нужен только при деплое за прокси/на проде (иначе можно не задавать)
# AUTH_URL=https://your-domain.ru
